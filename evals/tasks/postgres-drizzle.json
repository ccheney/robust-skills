  {
    "id": "postgres-tenant-rls",
    "skill": "postgres-drizzle",
    "category": "tenant-isolation",
    "group": "postgres-drizzle/postgres-tenant-rls",
    "split": "development",
    "prompt": "Enable RLS for app_user. Tenant identity comes from app.tenant_id; missing or empty settings must yield no rows. Reads and inserts must stay within that tenant. Do not hardcode tenant A or rely on table-owner behavior. Target PostgreSQL 18. Return SQL only; do not execute it against a live service.",
    "inputs": [
      "fixtures/postgres-drizzle/postgres-tenant-rls/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-tenant-rls/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-tenant-rls/bad-1.txt",
        "fails": [
          "tenant-a",
          "empty-tenant",
          "cross-tenant-insert"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-tenant-rls/bad-2.txt",
        "fails": [
          "empty-tenant"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-tenant-rls/input.sql",
      "query": false,
      "checks": [
        {
          "id": "tenant-a",
          "sql": "SET app.tenant_id='00000000-0000-0000-0000-000000000001'; SELECT id FROM documents ORDER BY id",
          "rows": [
            "1"
          ],
          "as_role": "app_user"
        },
        {
          "id": "tenant-b",
          "sql": "SET app.tenant_id='00000000-0000-0000-0000-000000000002'; SELECT id FROM documents ORDER BY id",
          "rows": [
            "2"
          ],
          "as_role": "app_user"
        },
        {
          "id": "empty-tenant",
          "sql": "SET app.tenant_id=''; SELECT count(*) FROM documents",
          "rows": [
            "0"
          ],
          "as_role": "app_user"
        },
        {
          "id": "cross-tenant-insert",
          "as_role": "app_user",
          "sql": "SET app.tenant_id='00000000-0000-0000-0000-000000000001'; INSERT INTO documents VALUES(3,'00000000-0000-0000-0000-000000000002','bad')",
          "error": "42501"
        },
        {
          "id": "same-tenant-insert",
          "as_role": "app_user",
          "sql": "SET app.tenant_id='00000000-0000-0000-0000-000000000001'; INSERT INTO documents VALUES(5,'00000000-0000-0000-0000-000000000001','A2') RETURNING body;",
          "rows": [
            "A2"
          ]
        }
      ]
    }
  },
  {
    "id": "postgres-atomic-reservation",
    "skill": "postgres-drizzle",
    "category": "concurrency",
    "group": "postgres-drizzle/postgres-atomic-reservation",
    "split": "holdout",
    "prompt": "Create reserve(item text,requested integer) returning boolean. Atomically decrement stock only if enough remains. Return false for unknown SKU, nonpositive quantity, or insufficient stock. Concurrent requests must not oversell. Target PostgreSQL 18. Return SQL only; do not execute it against a live service.",
    "inputs": [
      "fixtures/postgres-drizzle/postgres-atomic-reservation/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-atomic-reservation/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-atomic-reservation/bad-1.txt",
        "fails": [
          "one-reservation",
          "remaining-stock"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-atomic-reservation/bad-2.txt",
        "fails": [
          "invalid-quantity"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-atomic-reservation/input.sql",
      "query": false,
      "checks": [
        {
          "id": "one-reservation",
          "parallel": [
            "SELECT reserve('widget',3)",
            "SELECT reserve('widget',3)"
          ],
          "rows": [
            [
              "f"
            ],
            [
              "t"
            ]
          ]
        },
        {
          "id": "remaining-stock",
          "sql": "SELECT quantity FROM stock WHERE sku='widget'",
          "rows": [
            "2"
          ]
        },
        {
          "id": "invalid-quantity",
          "sql": "SELECT reserve('widget',-2)",
          "rows": [
            "f"
          ]
        },
        {
          "id": "unknown-sku",
          "sql": "SELECT reserve('missing',1)",
          "rows": [
            "f"
          ]
        }
      ]
    }
  },
  {
    "id": "drizzle-stable-schema",
    "skill": "postgres-drizzle",
    "category": "orm-compatibility",
    "group": "postgres-drizzle/drizzle-stable-schema",
    "split": "holdout",
    "prompt": "Use installed drizzle-orm 0.44.7 to implement and export users, posts, and postsRelations in one TypeScript module. Both tables have UUID primary-key id. users.email is required text. posts.userId maps to required UUID user_id, references users.id with cascade deletion, and has an index. Define author in postsRelations for db.query. Preserve the stable relations API; do not upgrade dependencies.",
    "inputs": [
      "fixtures/postgres-drizzle/drizzle-stable-schema/input.json"
    ],
    "grader": "drizzle-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/drizzle-stable-schema/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/drizzle-stable-schema/bad-1.txt",
        "fails": [
          "foreign-key"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/drizzle-stable-schema/bad-2.txt",
        "fails": [
          "required"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/drizzle-stable-schema/bad-3.txt",
        "fails": [
          "drizzle-types"
        ]
      }
    ],
    "assertions": [
      {
        "id": "users-primary",
        "op": "equals",
        "path": [
          "users",
          "columns",
          "id",
          "primary"
        ],
        "value": true
      },
      {
        "id": "uuid",
        "op": "equals",
        "path": [
          "posts",
          "columns",
          "user_id",
          "type"
        ],
        "value": "uuid"
      },
      {
        "id": "required",
        "op": "equals",
        "path": [
          "posts",
          "columns",
          "user_id",
          "notNull"
        ],
        "value": true
      },
      {
        "id": "index",
        "op": "equals",
        "path": [
          "posts",
          "indexes"
        ],
        "value": [
          [
            "user_id"
          ]
        ]
      },
      {
        "id": "foreign-key",
        "op": "equals",
        "path": [
          "posts",
          "foreignKeys"
        ],
        "value": [
          {
            "columns": [
              "user_id"
            ],
            "table": "users",
            "references": [
              "id"
            ],
            "onDelete": "cascade"
          }
        ]
      },
      {
        "id": "relation",
        "op": "equals",
        "path": [
          "author"
        ],
        "value": {
          "table": "users",
          "fields": [
            "user_id"
          ],
          "references": [
            "id"
          ]
        }
      }
    ]
  }
]
