    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-latest-valid-order/bad-1.txt",
        "fails": [
          "exclude-cancelled"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-latest-valid-order/bad-2.txt",
        "fails": [
          "deterministic-ties"
