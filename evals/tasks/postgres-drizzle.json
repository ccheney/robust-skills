[
  {
    "id": "postgres-nullable-fk",
    "skill": "postgres-drizzle",
    "category": "schema",
    "group": "postgres-drizzle/postgres-nullable-fk",
    "split": "development",
    "prompt": "Add nullable orders.customer_id referencing customers.id. Preserve existing rows and reject nonexistent customers. Do not cascade customer deletion. Target PostgreSQL 18. Return SQL only; do not execute it against a live service.",
    "inputs": [
      "fixtures/postgres-drizzle/postgres-nullable-fk/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-nullable-fk/good-1.txt",
      "reference_outputs/postgres-drizzle/postgres-nullable-fk/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-nullable-fk/bad-1.txt",
        "fails": [
          "foreign-key"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-nullable-fk/bad-2.txt",
        "fails": [
          "no-cascade"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-nullable-fk/input.sql",
      "query": false,
      "checks": [
        {
          "id": "preserve-rows",
          "sql": "SELECT count(*) FROM orders",
          "rows": [
            "1"
          ]
        },
        {
          "id": "nullable",
          "sql": "SELECT customer_id IS NULL FROM orders",
          "rows": [
            "t"
          ]
        },
        {
          "id": "foreign-key",
          "sql": "INSERT INTO orders VALUES('00000000-0000-0000-0000-000000000043','00000000-0000-0000-0000-000000000099')",
          "error": "23503"
        },
        {
          "id": "valid-customer",
          "sql": "UPDATE orders SET customer_id='00000000-0000-0000-0000-000000000001'",
          "rows": []
        },
        {
          "id": "no-cascade",
          "sql": "DELETE FROM customers",
          "error": "23503"
        }
      ]
    }
  },
  {
    "id": "postgres-backfill-required",
    "skill": "postgres-drizzle",
    "category": "migration",
    "group": "postgres-drizzle/postgres-backfill-required",
    "split": "development",
    "prompt": "Add required invoices.status without losing data. Existing zero-total invoices become settled; positive-total invoices become open. After backfill reject NULL status. Do not give both existing rows the same status. Target PostgreSQL 18. Return SQL only; do not execute it against a live service.",
    "inputs": [
      "fixtures/postgres-drizzle/postgres-backfill-required/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-backfill-required/good-1.txt",
      "reference_outputs/postgres-drizzle/postgres-backfill-required/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-backfill-required/bad-1.txt",
        "fails": [
          "correct-backfill"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-backfill-required/bad-2.txt",
        "fails": [
          "required-status"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-backfill-required/input.sql",
      "query": false,
      "checks": [
        {
          "id": "correct-backfill",
          "sql": "SELECT id,status,total FROM invoices ORDER BY id",
          "rows": [
            "1|open|100",
            "2|settled|0"
          ]
        },
        {
          "id": "required-status",
          "sql": "INSERT INTO invoices VALUES(3,20,NULL)",
          "error": "23502"
        }
      ]
    }
  },
  {
    "id": "postgres-partial-unique",
    "skill": "postgres-drizzle",
    "category": "indexing",
    "group": "postgres-drizzle/postgres-partial-unique",
    "split": "development",
