      "fixtures/postgres-drizzle/postgres-partial-unique/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-partial-unique/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-partial-unique/bad-1.txt",
        "fails": [
          "archived-duplicate"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-partial-unique/bad-2.txt",
        "fails": [
          "live-duplicate"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-partial-unique/input.sql",
      "query": false,
      "checks": [
        {
          "id": "archived-duplicate",
          "sql": "INSERT INTO users VALUES(2,'a@example.com','2026-01-01')",
          "rows": []
        },
        {
          "id": "live-duplicate",
          "sql": "INSERT INTO users VALUES(3,'a@example.com',NULL)",
          "error": "23505"
        },
        {
          "id": "existing-row",
          "sql": "SELECT count(*) FROM users WHERE id=1",
          "rows": [
            "1"
          ]
        }
      ]
    }
  },
  {
    "id": "postgres-keyset-ties",
    "skill": "postgres-drizzle",
    "category": "pagination",
    "group": "postgres-drizzle/postgres-keyset-ties",
    "split": "holdout",
    "prompt": "Return the next two events after cursor (2026-01-02T00:00:00Z,id=2), ordered ascending by created_at then id. Include tied timestamps without repeating the cursor row. Expose id and created_at columns. Target PostgreSQL 18. Return SQL only; do not execute it against a live service.",
    "inputs": [
      "fixtures/postgres-drizzle/postgres-keyset-ties/input.sql"
    ],
    "grader": "postgres-runtime",
    "references": [
      "reference_outputs/postgres-drizzle/postgres-keyset-ties/good-1.txt",
      "reference_outputs/postgres-drizzle/postgres-keyset-ties/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/postgres-drizzle/postgres-keyset-ties/bad-1.txt",
        "fails": [
          "ties-not-skipped"
        ]
      },
      {
        "path": "reference_outputs/postgres-drizzle/postgres-keyset-ties/bad-2.txt",
        "fails": [
          "cursor-not-repeated"
        ]
      }
    ],
    "runtime": {
      "setup": "fixtures/postgres-drizzle/postgres-keyset-ties/input.sql",
      "query": true,
      "checks": [
        {
          "id": "ties-not-skipped",
          "sql": "SELECT id FROM result ORDER BY created_at,id",
          "rows": [
            "3",
            "4"
          ]
        },
        {
          "id": "cursor-not-repeated",
          "sql": "SELECT count(*) FROM result WHERE id=2",
          "rows": [
            "0"
          ]
        },
        {
          "id": "new-data",
          "sql": "SELECT id FROM result ORDER BY created_at,id",
          "rows": [
            "3",
            "5"
          ],
          "before": "INSERT INTO events VALUES(5,'2026-01-02')"
        }
      ]
    }
  },
  {
