  {
    "id": "css-theme-override",
    "skill": "modern-css",
    "category": "theming",
    "group": "modern-css/css-theme-override",
    "split": "holdout",
    "prompt": "The panel is white in light mode and rgb(20 20 20) in dark mode. A data-theme=\"light\" attribute on html must override a dark OS preference. Respect both system preference and the explicit override. Return only a CSS stylesheet. Target the pinned Chromium browser; do not change the HTML.",
    "inputs": [
      "fixtures/modern-css/css-theme-override/input.json"
    ],
    "grader": "css-runtime",
    "references": [
      "reference_outputs/modern-css/css-theme-override/good-1.txt",
      "reference_outputs/modern-css/css-theme-override/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/modern-css/css-theme-override/bad-1.txt",
        "fails": [
          "dark/background"
        ]
      },
      {
        "path": "reference_outputs/modern-css/css-theme-override/bad-2.txt",
        "fails": [
          "override/background"
        ]
      }
    ],
    "runtime": {
      "html": "fixtures/modern-css/css-theme-override/page.html",
      "states": [
        {
          "id": "light",
          "media": {
            "colorScheme": "light"
          },
          "checks": [
            {
              "id": "background",
              "kind": "style",
              "selector": ".panel",
              "property": "background-color",
              "value": "rgb(255, 255, 255)"
            }
          ]
        },
        {
          "id": "dark",
          "media": {
            "colorScheme": "dark"
          },
          "checks": [
            {
              "id": "background",
              "kind": "style",
              "selector": ".panel",
              "property": "background-color",
              "value": "rgb(20, 20, 20)"
            }
          ]
        },
        {
          "id": "override",
          "media": {
            "colorScheme": "dark"
          },
          "attributes": [
            {
              "selector": "html",
              "name": "data-theme",
              "value": "light"
            }
          ],
          "checks": [
            {
              "id": "background",
              "kind": "style",
              "selector": ".panel",
              "property": "background-color",
              "value": "rgb(255, 255, 255)"
            }
          ]
        }
      ]
    }
  },
