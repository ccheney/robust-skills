[
  {
    "id": "css-responsive-cards",
    "skill": "modern-css",
    "category": "layout",
    "group": "modern-css/css-responsive-cards",
    "split": "development",
    "prompt": "Render three equal cards in a row above 500px viewport width, in a container no wider than 600px. At 400px viewport width stack cards at full available width. Use 16px gaps and avoid horizontal overflow. Return only a CSS stylesheet. Target the pinned Chromium browser; do not change the HTML.",
    "inputs": [
      "fixtures/modern-css/css-responsive-cards/input.json"
    ],
    "grader": "css-runtime",
    "references": [
      "reference_outputs/modern-css/css-responsive-cards/good-1.txt",
      "reference_outputs/modern-css/css-responsive-cards/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/modern-css/css-responsive-cards/bad-1.txt",
        "fails": [
          "mobile/stacked"
        ]
      },
      {
        "path": "reference_outputs/modern-css/css-responsive-cards/bad-2.txt",
        "fails": [
          "desktop/gap"
        ]
      }
    ],
    "runtime": {
      "html": "fixtures/modern-css/css-responsive-cards/page.html",
      "states": [
        {
          "id": "desktop",
          "viewport": {
            "width": 1000,
            "height": 600
          },
          "checks": [
            {
              "id": "row",
              "kind": "same-row",
              "selector": "#a",
              "other": "#c",
              "value": true
            },
            {
              "id": "gap",
              "kind": "gap-x",
              "selector": "#a",
              "other": "#b",
              "value": 16
            },
            {
              "id": "equal-width",
              "kind": "rect",
              "selector": "#a",
              "property": "width",
              "value": 189.33333333333334
            }
          ]
        },
        {
          "id": "mobile",
          "viewport": {
            "width": 400,
            "height": 600
          },
          "checks": [
            {
              "id": "stacked",
              "kind": "same-column",
              "selector": "#a",
              "other": "#b",
              "value": true
            },
            {
              "id": "gap",
              "kind": "gap-y",
              "selector": "#a",
              "other": "#b",
              "value": 16
            },
            {
              "id": "full-width",
              "kind": "rect",
              "selector": "#a",
              "property": "width",
              "value": 400
            },
            {
              "id": "overflow",
              "kind": "overflow",
              "value": true
            }
          ]
        }
      ]
    }
  },
