[
  {
    "id": "fsd-cross-entity-api",
    "skill": "feature-slicing",
    "category": "cross-entity",
    "group": "feature-slicing/fsd-cross-entity-api",
    "split": "development",
    "prompt": "Repair the order entity dependency without exposing product internals. Output from, to, and public_export. Preserve the order source file and use the product @x API intended for order; export ProductId only. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/feature-slicing/fsd-cross-entity-api/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/feature-slicing/fsd-cross-entity-api/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/feature-slicing/fsd-cross-entity-api/bad-1.txt",
        "fails": [
          "explicit-cross-api"
        ]
      },
      {
        "path": "reference_outputs/feature-slicing/fsd-cross-entity-api/bad-2.txt",
        "fails": [
          "narrow-export"
        ]
      }
    ],
    "assertions": [
      {
        "id": "source-preserved",
        "op": "equals",
        "path": [
          "from"
        ],
        "value": "src/entities/order/model/types.ts"
      },
      {
        "id": "explicit-cross-api",
        "op": "one_of",
        "path": [
          "to"
        ],
        "value": [
          "src/entities/product/@x/order",
          "src/entities/product/@x/order.ts"
        ]
      },
      {
        "id": "narrow-export",
        "op": "set_equals",
        "path": [
          "public_export"
        ],
        "value": [
          "ProductId"
        ]
      }
    ]
  },
  {
