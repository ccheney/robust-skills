  {
    "id": "bazel-configured-query",
    "skill": "bazel",
    "category": "diagnostics",
    "group": "bazel/bazel-configured-query",
    "split": "development",
    "prompt": "Choose the query that reveals configured dependencies of //app:server for the failing invocation. Output tool, expression, and flags. Preserve both supplied configuration flags. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/bazel/bazel-configured-query/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/bazel/bazel-configured-query/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-configured-query/bad-1.txt",
        "fails": [
          "configured-graph"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-configured-query/bad-2.txt",
        "fails": [
          "same-configuration"
        ]
      }
    ],
    "assertions": [
      {
        "id": "configured-graph",
        "op": "equals",
        "path": [
          "tool"
        ],
        "value": "cquery"
      },
      {
        "id": "target-expression",
        "op": "equals",
        "path": [
          "expression"
        ],
        "value": "deps(//app:server)"
      },
      {
        "id": "same-configuration",
        "op": "set_equals",
        "path": [
          "flags"
        ],
        "value": [
          "--config=ci",
          "--platforms=//platforms:linux_arm64"
        ]
      }
    ]
  },
  {
    "id": "bazel-cache-diagnosis",
    "skill": "bazel",
    "category": "cache-correctness",
    "group": "bazel/bazel-cache-diagnosis",
    "split": "holdout",
    "prompt": "Plan diagnosis of a wrong remote cache hit. Output graph_tool, compare, clean_first, and disable_sandbox. Investigate the action contract before deleting caches or weakening isolation. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/bazel/bazel-cache-diagnosis/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/bazel/bazel-cache-diagnosis/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-cache-diagnosis/bad-1.txt",
        "fails": [
          "preserve-evidence"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-cache-diagnosis/bad-2.txt",
        "fails": [
          "preserve-isolation"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-cache-diagnosis/bad-3.txt",
        "fails": [
          "action-graph"
        ]
      }
    ],
    "assertions": [
      {
        "id": "action-graph",
        "op": "equals",
        "path": [
          "graph_tool"
        ],
        "value": "aquery"
      },
      {
        "id": "compare-action-key",
        "op": "contains_all",
        "path": [
          "compare"
        ],
        "value": [
          "argv",
          "inputs",
          "environment",
          "execution_platform"
        ]
      },
      {
        "id": "preserve-evidence",
        "op": "equals",
        "path": [
          "clean_first"
        ],
        "value": false
      },
      {
        "id": "preserve-isolation",
        "op": "equals",
        "path": [
          "disable_sandbox"
        ],
        "value": false
      }
    ]
  },
  {
    "id": "bazel-preserve-version",
    "skill": "bazel",
    "category": "scope-preservation",
    "group": "bazel/bazel-preserve-version",
    "split": "development",
    "prompt": "Plan only the authorized visibility correction in this Bazel 8 repository. Output bazel_version, dependency_system, changed_files, and migration_required. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/bazel/bazel-preserve-version/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/bazel/bazel-preserve-version/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-preserve-version/bad-1.txt",
        "fails": [
          "pin"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-preserve-version/bad-2.txt",
        "fails": [
          "change-scope"
        ]
      }
    ],
    "assertions": [
      {
        "id": "pin",
        "op": "equals",
        "path": [
          "bazel_version"
        ],
        "value": "8.4.2"
      },
      {
        "id": "dependency-system",
        "op": "equals",
        "path": [
          "dependency_system"
        ],
        "value": "WORKSPACE"
      },
      {
        "id": "change-scope",
        "op": "set_equals",
        "path": [
          "changed_files"
        ],
        "value": [
          "lib/auth/BUILD.bazel"
        ]
      },
      {
        "id": "no-upgrade",
        "op": "equals",
        "path": [
          "migration_required"
        ],
        "value": false
      }
    ]
  }
