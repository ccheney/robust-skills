[
  {
    "id": "bazel-direct-dependency",
    "skill": "bazel",
    "category": "build-graph",
    "group": "bazel/bazel-direct-dependency",
    "split": "development",
    "prompt": "main.cc directly includes the protocol header owned by //lib:protocol. Add the direct edge for server. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-direct-dependency/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-direct-dependency/good-1.txt",
      "reference_outputs/bazel/bazel-direct-dependency/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-direct-dependency/bad-1.txt",
        "fails": [
          "direct-edge"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-direct-dependency/bad-2.txt",
        "fails": [
          "direct-edge"
        ]
      }
    ],
    "assertions": [
      {
        "id": "source",
        "op": "set_equals",
        "path": [
          "targets",
          "server",
          "srcs"
        ],
        "value": [
          "main.cc"
        ]
      },
      {
        "id": "rule",
        "op": "equals",
        "path": [
          "targets",
          "server",
          "rule"
        ],
        "value": "cc_binary"
      },
      {
        "id": "direct-edge",
        "op": "contains",
        "path": [
          "targets",
          "server",
          "deps"
        ],
        "value": "//lib:protocol"
      }
    ],
    "runtime": {
      "file_type": "build"
    }
  },
  {
    "id": "bazel-runtime-data",
    "skill": "bazel",
    "category": "runfiles",
    "group": "bazel/bazel-runtime-data",
    "split": "development",
    "prompt": "config_test reads assets/settings.json through runfiles. Declare its runtime dependency without adding it to Python deps. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-runtime-data/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-runtime-data/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-runtime-data/bad-1.txt",
        "fails": [
          "runfiles-edge"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-runtime-data/bad-2.txt",
        "fails": [
          "runfiles-edge"
        ]
      }
    ],
    "assertions": [
      {
        "id": "runfiles-edge",
        "op": "contains",
        "path": [
          "targets",
          "config_test",
          "data"
        ],
        "value": "//assets:settings.json"
      },
      {
        "id": "test-source",
        "op": "set_equals",
        "path": [
          "targets",
          "config_test",
          "srcs"
        ],
        "value": [
          "config_test.py"
        ]
      }
    ],
    "runtime": {
      "file_type": "build"
    }
  },
  {
    "id": "bazel-narrow-visibility",
    "skill": "bazel",
    "category": "visibility",
    "group": "bazel/bazel-narrow-visibility",
    "split": "development",
    "prompt": "Expose auth only to the exact //app/server package. Do not make it public or expose the whole app subtree. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-narrow-visibility/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-narrow-visibility/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-narrow-visibility/bad-1.txt",
        "fails": [
          "narrow-api"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-narrow-visibility/bad-2.txt",
        "fails": [
          "narrow-api"
        ]
      }
    ],
    "assertions": [
      {
        "id": "narrow-api",
        "op": "set_equals",
        "path": [
          "targets",
          "auth",
          "visibility"
        ],
        "value": [
          "//app/server:__pkg__"
        ]
      },
      {
        "id": "source",
        "op": "set_equals",
        "path": [
          "targets",
          "auth",
          "srcs"
        ],
        "value": [
          "auth.cc"
        ]
      }
    ],
    "runtime": {
      "file_type": "build"
    }
  },
  {
    "id": "bazel-hermetic-tool",
    "skill": "bazel",
    "category": "hermeticity",
    "group": "bazel/bazel-hermetic-tool",
    "split": "holdout",
    "prompt": "Replace the host-discovered compiler with the executable target :compiler. The compiler reads schema.json and writes stdout, which must become the declared generated.txt output. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-hermetic-tool/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-hermetic-tool/good-1.txt",
      "reference_outputs/bazel/bazel-hermetic-tool/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-hermetic-tool/bad-1.txt",
        "fails": [
          "declared-tool"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-hermetic-tool/bad-2.txt",
        "fails": [
          "resolved-tool"
        ]
      }
    ],
    "assertions": [
      {
        "id": "declared-tool",
        "op": "contains",
        "path": [
          "targets",
          "generated",
          "tools"
        ],
        "value": ":compiler"
      },
      {
        "id": "input",
        "op": "set_equals",
        "path": [
          "targets",
          "generated",
          "srcs"
        ],
        "value": [
          "schema.json"
        ]
      },
      {
        "id": "output",
        "op": "set_equals",
        "path": [
          "targets",
          "generated",
          "outs"
        ],
        "value": [
          "generated.txt"
        ]
      },
      {
        "id": "resolved-tool",
        "op": "matches",
        "path": [
          "targets",
          "generated",
          "cmd"
        ],
        "value": ".*\\$\\((location|execpath) :compiler\\).*"
      }
    ],
    "runtime": {
      "file_type": "build"
    }
  },
  {
    "id": "bazel-use-repo",
    "skill": "bazel",
    "category": "bzlmod",
    "group": "bazel/bazel-use-repo",
    "split": "development",
    "prompt": "BUILD files already load from @pypi. Import the repository produced by the pip extension. Do not change module or Python version pins. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-use-repo/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-use-repo/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-use-repo/bad-1.txt",
        "fails": [
          "extension-import"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-use-repo/bad-2.txt",
        "fails": [
          "extension-import"
        ]
      }
    ],
    "assertions": [
      {
        "id": "extension-import",
        "op": "contains",
        "path": [
          "repositories"
        ],
        "value": "pypi"
      },
      {
        "id": "module-pin",
        "op": "equals",
        "path": [
          "targets",
          "rules_python",
          "version"
        ],
        "value": "1.7.0"
      },
      {
        "id": "python-pin",
        "op": "equals",
        "path": [
          "calls",
          1,
          "kwargs",
          "python_version"
        ],
        "value": "3.12"
      }
    ],
    "runtime": {
      "file_type": "module"
    }
  },
  {
    "id": "bazel-select-branches",
    "skill": "bazel",
    "category": "configuration",
    "group": "bazel/bazel-select-branches",
    "split": "development",
    "prompt": "Select -DPROD when --define env=prod matches production; use -DDEV otherwise. Preserve main.cc and express the condition in Bazel configuration. Return only the complete Starlark file. Preserve the supplied version and unrelated declarations.",
    "inputs": [
      "fixtures/bazel/bazel-select-branches/input.json"
    ],
    "grader": "starlark-runtime",
    "references": [
      "reference_outputs/bazel/bazel-select-branches/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/bazel/bazel-select-branches/bad-1.txt",
        "fails": [
          "production-branch",
          "default-branch"
        ]
      },
      {
        "path": "reference_outputs/bazel/bazel-select-branches/bad-2.txt",
        "fails": [
          "condition"
        ]
      }
    ],
    "assertions": [
      {
        "id": "condition",
        "op": "equals",
        "path": [
          "targets",
          "production",
          "define_values",
          "env"
        ],
        "value": "prod"
      },
      {
        "id": "production-branch",
        "op": "set_equals",
        "path": [
          "targets",
          "app",
          "copts",
          "args",
          0,
          ":production"
        ],
        "value": [
          "-DPROD"
        ]
      },
      {
        "id": "default-branch",
        "op": "set_equals",
        "path": [
          "targets",
          "app",
          "copts",
          "args",
          0,
          "//conditions:default"
        ],
        "value": [
          "-DDEV"
        ]
      }
    ],
    "runtime": {
      "file_type": "build"
    }
  },
  {
