    "prompt": "Choose a proportionate solution for the dashboard. Output read_strategy (projection or reporting_view), write_source, event_sourcing, and new_microservices. We can use a SQL reporting view or maintained projection; keep authoritative writes in the existing database. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/clean-ddd-hexagonal/ddd-read-model/input.json"
    ],
    "grader": "contract",
