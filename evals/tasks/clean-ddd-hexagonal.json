        "path": "reference_outputs/clean-ddd-hexagonal/ddd-order-confirm/bad-1.txt",
        "fails": [
          "empty-rejected",
          "single-transition",
          "valid-items"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-order-confirm/bad-2.txt",
        "fails": [
          "records-fact"
