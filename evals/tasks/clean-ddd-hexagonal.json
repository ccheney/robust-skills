          "currency",
          "immutable"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-money-value-object/bad-2.txt",
        "fails": [
          "nonmutating-add"
        ]
      }
    ],
    "test": "assertions/clean-ddd-hexagonal/ddd-money-value-object.mjs",
