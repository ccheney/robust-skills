[
  {
    "id": "ddd-atomic-transfer",
    "skill": "clean-ddd-hexagonal",
    "category": "transaction-boundaries",
    "group": "clean-ddd-hexagonal/ddd-atomic-transfer",
    "split": "development",
    "prompt": "Review the transfer design. Output consistency (atomic or eventual), transaction_members (operation IDs), async_credit (boolean), and presentation_path. Both debit and credit must commit or roll back together; keep the current folders. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/clean-ddd-hexagonal/ddd-atomic-transfer/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/clean-ddd-hexagonal/ddd-atomic-transfer/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-atomic-transfer/bad-1.txt",
        "fails": [
          "atomic"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-atomic-transfer/bad-2.txt",
        "fails": [
          "both-writes"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-atomic-transfer/bad-3.txt",
        "fails": [
          "no-async-credit"
        ]
      }
    ],
    "assertions": [
      {
        "id": "atomic",
        "op": "equals",
        "path": [
          "consistency"
        ],
        "value": "atomic"
      },
      {
        "id": "both-writes",
        "op": "contains_all",
        "path": [
          "transaction_members"
        ],
        "value": [
          "debit",
          "credit"
        ]
      },
      {
        "id": "no-async-credit",
        "op": "equals",
        "path": [
          "async_credit"
        ],
        "value": false
      },
      {
        "id": "preserve-layout",
        "op": "equals",
        "path": [
          "presentation_path"
        ],
        "value": "presentation"
      }
    ]
  },
  {
    "id": "ddd-outbox-commit",
    "skill": "clean-ddd-hexagonal",
    "category": "reliability",
    "group": "clean-ddd-hexagonal/ddd-outbox-commit",
    "split": "development",
    "prompt": "Replace the unsafe dual write with an outbox plan. Output atomic_operations, broker_publish_phase (inside_transaction or after_commit), delivery (at_least_once or exactly_once), and consumer_deduplication. Assume the broker can redeliver messages. Return only JSON using the fields requested; preserve supplied identifiers.",
