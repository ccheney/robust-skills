      "reference_outputs/clean-ddd-hexagonal/ddd-outbox-commit/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-outbox-commit/bad-1.txt",
        "fails": [
          "atomic-outbox"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-outbox-commit/bad-2.txt",
        "fails": [
          "delivery-contract"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-outbox-commit/bad-3.txt",
        "fails": [
          "idempotent-consumer"
        ]
      }
    ],
    "assertions": [
      {
        "id": "atomic-outbox",
        "op": "contains_all",
        "path": [
          "atomic_operations"
        ],
        "value": [
          "save_order",
          "insert_outbox"
        ]
      },
      {
        "id": "publish-after",
        "op": "equals",
        "path": [
          "broker_publish_phase"
        ],
        "value": "after_commit"
      },
      {
        "id": "delivery-contract",
        "op": "equals",
        "path": [
          "delivery"
        ],
        "value": "at_least_once"
      },
      {
        "id": "idempotent-consumer",
        "op": "equals",
        "path": [
          "consumer_deduplication"
        ],
        "value": true
      }
    ]
  },
  {
    "id": "ddd-dependency-direction",
    "skill": "clean-ddd-hexagonal",
    "category": "dependency-boundaries",
    "group": "clean-ddd-hexagonal/ddd-dependency-direction",
    "split": "development",
    "prompt": "Assign each supplied concern to domain, application, or infrastructure under our Clean Architecture conventions. Output placements (concern ID to layer) and imports using layer names. The domain must remain independent of the database and HTTP. Return only JSON using the fields requested; preserve supplied identifiers.",
    "inputs": [
      "fixtures/clean-ddd-hexagonal/ddd-dependency-direction/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/clean-ddd-hexagonal/ddd-dependency-direction/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-dependency-direction/bad-1.txt",
        "fails": [
          "invariant-owner"
        ]
      },
      {
        "path": "reference_outputs/clean-ddd-hexagonal/ddd-dependency-direction/bad-2.txt",
        "fails": [
          "inward-imports"
        ]
      }
    ],
    "assertions": [
      {
        "id": "invariant-owner",
        "op": "equals",
        "path": [
          "placements",
          "minimum_balance"
        ],
        "value": "domain"
      },
      {
        "id": "orchestration-owner",
        "op": "equals",
        "path": [
          "placements",
          "transfer"
        ],
        "value": "application"
      },
      {
        "id": "sql-owner",
        "op": "equals",
        "path": [
          "placements",
          "sql_account_repository"
        ],
        "value": "infrastructure"
      },
      {
        "id": "port-owner",
        "op": "equals",
        "path": [
          "placements",
          "account_repository_port"
        ],
        "value": "domain"
      },
      {
        "id": "inward-imports",
        "op": "edges",
        "path": [
          "imports"
        ],
        "required": [
          [
            "application",
            "domain"
          ],
          [
            "infrastructure",
            "domain"
          ]
        ],
        "allowed": [
          [
            "application",
            "domain"
          ],
          [
            "infrastructure",
            "domain"
          ],
          [
            "infrastructure",
            "application"
          ]
        ]
      },
      {
        "id": "acyclic",
        "op": "acyclic",
        "path": [
          "imports"
        ]
      }
    ]
  },
