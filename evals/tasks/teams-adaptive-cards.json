[
  {
    "id": "teams-required-input",
    "skill": "teams-adaptive-cards",
    "category": "forms",
    "group": "teams-adaptive-cards/teams-required-input",
    "split": "development",
    "prompt": "Repair this bot approval form. Keep the reason input required with a visible label and validation message, and preserve the request/action correlation. The bot already handles Submit. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/teams-adaptive-cards/teams-required-input/input.json"
    ],
    "grader": "teams-contract",
    "references": [
      "reference_outputs/teams-adaptive-cards/teams-required-input/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/teams-adaptive-cards/teams-required-input/bad-1.txt",
        "fails": [
          "required"
        ]
      },
      {
        "path": "reference_outputs/teams-adaptive-cards/teams-required-input/bad-2.txt",
        "fails": [
          "correlation"
        ]
      }
    ],
    "assertions": [
      {
        "id": "input-id",
        "op": "equals",
        "path": [
          "body",
          0,
          "id"
        ],
        "value": "reason"
      },
      {
        "id": "input-type",
        "op": "equals",
        "path": [
          "body",
          0,
          "type"
        ],
        "value": "Input.Text"
      },
      {
        "id": "label",
        "op": "equals",
        "path": [
          "body",
          0,
          "label"
        ],
        "value": "Reason"
      },
      {
        "id": "required",
        "op": "equals",
        "path": [
          "body",
          0,
          "isRequired"
        ],
        "value": true
      },
      {
        "id": "validation-message",
        "op": "length",
        "path": [
          "body",
          0,
          "errorMessage"
        ],
        "min": 1
      },
      {
        "id": "submit",
        "op": "equals",
        "path": [
          "actions",
          0,
          "type"
        ],
        "value": "Action.Submit"
      },
      {
        "id": "correlation",
        "op": "equals",
        "path": [
          "actions",
          0,
          "data"
        ],
        "value": {
          "action": "approve",
          "requestId": "REQ-42"
        }
      }
    ],
    "runtime": {
      "target": "card"
    }
  },
