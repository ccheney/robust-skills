[
  {
    "id": "teams-escape-html",
    "skill": "teams-message-formatting",
    "category": "escaping",
    "group": "teams-message-formatting/teams-escape-html",
    "split": "development",
    "prompt": "Implement escapeHtml(text) for raw untrusted text inserted inside a Teams Graph HTML body text node (not an attribute). Preserve visible characters and neutralize HTML/mention injection. Return only the JavaScript ES module. Use Node 24, no dependencies.",
    "inputs": [
      "fixtures/teams-message-formatting/teams-escape-html/input.json"
    ],
    "grader": "javascript-runtime",
    "references": [
      "reference_outputs/teams-message-formatting/teams-escape-html/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/teams-message-formatting/teams-escape-html/bad-1.txt",
        "fails": [
          "neutralize-tags"
        ]
      },
      {
        "path": "reference_outputs/teams-message-formatting/teams-escape-html/bad-2.txt",
        "fails": [
          "escape-order"
        ]
      }
    ],
    "test": "assertions/teams-message-formatting/teams-escape-html.mjs",
    "exports": [
      "escapeHtml"
    ],
    "assertion_ids": [
      "neutralize-tags",
      "escape-order",
      "literal-entities",
      "unicode",
      "empty"
    ]
  },
  {
    "id": "teams-graph-renderer",
    "skill": "teams-message-formatting",
    "category": "renderer",
    "group": "teams-message-formatting/teams-graph-renderer",
    "split": "development",
    "prompt": "Repair this Graph HTML body. Show Release 42 in bold, followed by a colon and a labelled View release link. Preserve destination and visible content. Return {body}. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/teams-message-formatting/teams-graph-renderer/input.json"
    ],
    "grader": "markup-contract",
    "references": [
      "reference_outputs/teams-message-formatting/teams-graph-renderer/good-1.txt",
      "reference_outputs/teams-message-formatting/teams-graph-renderer/good-2.txt",
      "reference_outputs/teams-message-formatting/teams-graph-renderer/good-3.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/teams-message-formatting/teams-graph-renderer/bad-1.txt",
        "fails": [
          "bold",
          "link"
        ]
      },
      {
        "path": "reference_outputs/teams-message-formatting/teams-graph-renderer/bad-2.txt",
        "fails": [
          "link"
        ]
      }
    ],
    "assertions": [
      {
        "id": "html-body",
        "op": "equals",
        "path": [
          "body",
          "contentType"
        ],
        "value": "html"
      }
    ],
    "runtime": {
      "text_path": [
        "body",
        "content"
      ],
      "assertions": [
        {
          "id": "visible-content",
          "op": "equals",
          "path": [
            "text"
          ],
          "value": "Release 42: View release"
        },
        {
          "id": "bold",
          "op": "equals",
          "path": [
            "bold_text"
          ],
          "value": "Release 42"
        },
        {
          "id": "link",
          "op": "set_equals",
          "path": [
            "links"
          ],
          "value": [
            "https://example.com/42"
          ]
        }
      ]
    }
  },
  {
    "id": "teams-graph-mention",
    "skill": "teams-message-formatting",
    "category": "mentions",
    "group": "teams-message-formatting/teams-graph-mention",
    "split": "development",
    "prompt": "Repair this Graph personal mention, using the supplied Entra ID. The visible name is Ada and the sentence is Ada please review. Keep one mention only, index 0. Return body and mentions. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/teams-message-formatting/teams-graph-mention/input.json"
    ],
    "grader": "markup-contract",
    "references": [
      "reference_outputs/teams-message-formatting/teams-graph-mention/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/teams-message-formatting/teams-graph-mention/bad-1.txt",
        "fails": [
          "metadata-matches"
        ]
      },
      {
        "path": "reference_outputs/teams-message-formatting/teams-graph-mention/bad-2.txt",
        "fails": [
          "identity"
        ]
      }
    ],
    "assertions": [
      {
        "id": "html",
        "op": "equals",
        "path": [
          "body",
          "contentType"
        ],
        "value": "html"
      },
      {
        "id": "identity",
        "op": "equals",
        "path": [
          "mentions",
          0,
          "mentioned",
          "user",
          "id"
        ],
        "value": "11111111-1111-4111-8111-111111111111"
      },
      {
        "id": "index",
        "op": "equals",
        "path": [
          "mentions",
          0,
          "id"
        ],
        "value": 0
      },
      {
        "id": "name",
        "op": "equals",
        "path": [
          "mentions",
          0,
          "mentionText"
        ],
        "value": "Ada"
      },
      {
        "id": "single-mention",
        "op": "length",
        "path": [
          "mentions"
        ],
        "min": 1,
        "max": 1
      }
    ],
    "runtime": {
      "text_path": [
        "body",
        "content"
      ],
      "graph_mentions": true,
      "assertions": [
        {
          "id": "visible",
          "op": "equals",
          "path": [
            "text"
          ],
          "value": "Ada please review."
        },
        {
          "id": "metadata-matches",
          "op": "equals",
          "path": [
            "mentions_consistent"
          ],
          "value": true
        }
      ]
    }
  },
