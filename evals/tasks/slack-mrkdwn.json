[
  {
    "id": "slack-escape-untrusted",
    "skill": "slack-mrkdwn",
    "category": "escaping",
    "group": "slack-mrkdwn/slack-escape-untrusted",
    "split": "development",
    "prompt": "Implement escapeMrkdwn(text) for raw user text going into a Slack mrkdwn field. Neutralize control delimiters while preserving quotes, Unicode, and ordinary formatting markers. The input is raw, not pre-escaped. Return only the JavaScript ES module. Use Node 24, no dependencies.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-escape-untrusted/input.json"
    ],
    "grader": "javascript-runtime",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-escape-untrusted/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-escape-untrusted/bad-1.txt",
        "fails": [
          "single-encoding"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-escape-untrusted/bad-2.txt",
        "fails": [
          "mention-neutralized",
          "link-neutralized"
        ]
      }
    ],
    "test": "assertions/slack-mrkdwn/slack-escape-untrusted.mjs",
    "exports": [
      "escapeMrkdwn"
    ],
    "assertion_ids": [
      "single-encoding",
      "mention-neutralized",
      "link-neutralized",
      "raw-ampersands",
      "preserves-content",
      "empty"
    ]
  },
  {
    "id": "slack-date-seconds",
    "skill": "slack-mrkdwn",
    "category": "date-controls",
    "group": "slack-mrkdwn/slack-date-seconds",
    "split": "holdout",
    "prompt": "Implement dateToken(date, fallback) returning a Slack date control with {date_num} {time}, Unix seconds (floor), and the supplied already-safe timezone-bearing fallback. date is a valid Date. No link. Return only the JavaScript ES module. Use Node 24, no dependencies.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-date-seconds/input.json"
    ],
    "grader": "javascript-runtime",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-date-seconds/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-date-seconds/bad-1.txt",
        "fails": [
          "seconds"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-date-seconds/bad-2.txt",
        "fails": [
          "fallback"
        ]
      }
    ],
    "test": "assertions/slack-mrkdwn/slack-date-seconds.mjs",
    "exports": [
      "dateToken"
    ],
    "assertion_ids": [
      "seconds",
      "fallback",
      "negative-time"
    ]
  },
  {
    "id": "slack-trusted-mention-boundary",
    "skill": "slack-mrkdwn",
    "category": "mention-boundaries",
    "group": "slack-mrkdwn/slack-trusted-mention-boundary",
    "split": "holdout",
    "prompt": "Implement assignment(userId, note). Produce Assigned to <@ID>: NOTE in a Slack mrkdwn string. userId is a supplied valid Slack ID; note is raw untrusted text. Only the intended assignee should notify. Return only the JavaScript ES module. Use Node 24, no dependencies.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-trusted-mention-boundary/input.json"
    ],
    "grader": "javascript-runtime",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-trusted-mention-boundary/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-trusted-mention-boundary/bad-1.txt",
        "fails": [
          "untrusted-note"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-trusted-mention-boundary/bad-2.txt",
        "fails": [
          "intended-assignee"
        ]
      }
    ],
    "test": "assertions/slack-mrkdwn/slack-trusted-mention-boundary.mjs",
    "exports": [
      "assignment"
    ],
    "assertion_ids": [
      "intended-assignee",
      "untrusted-note",
      "alternate-id"
    ]
  },
  {
    "id": "slack-message-renderer",
    "skill": "slack-mrkdwn",
    "category": "renderer",
    "group": "slack-mrkdwn/slack-message-renderer",
    "split": "development",
    "prompt": "Repair the Slack chat.postMessage text field. Preserve the two lines, bold status, URL and link label. Keep a text-only message. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-message-renderer/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-message-renderer/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-message-renderer/bad-1.txt",
        "fails": [
          "message-markup"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-message-renderer/bad-2.txt",
        "fails": [
          "message-markup"
        ]
      }
    ],
    "assertions": [
      {
        "id": "message-markup",
        "op": "equals",
        "path": [
          "text"
        ],
        "value": "*Build failed*\n<https://example.com/build/42|View build>"
      },
      {
        "id": "no-blocks",
        "op": "absent",
        "path": [
          "blocks"
        ]
      }
    ]
  },
  {
    "id": "slack-standard-markdown-field",
