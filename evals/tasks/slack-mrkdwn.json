  {
    "id": "slack-literal-label",
    "skill": "slack-mrkdwn",
    "category": "literal-text",
    "group": "slack-mrkdwn/slack-literal-label",
    "split": "development",
    "prompt": "Format the literal button label for a Slack plain_text text object. Preserve every visible character; the label must have no formatting or notification behavior. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-literal-label/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-literal-label/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-literal-label/bad-1.txt",
        "fails": [
          "literal-type"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-literal-label/bad-2.txt",
        "fails": [
          "literal-content"
        ]
      }
    ],
    "assertions": [
      {
        "id": "literal-type",
        "op": "equals",
        "path": [
          "type"
        ],
        "value": "plain_text"
      },
      {
        "id": "literal-content",
        "op": "equals",
        "path": [
          "text"
        ],
        "value": "R&D <ops> \"ready\""
      },
      {
        "id": "no-verbatim",
        "op": "absent",
        "path": [
          "verbatim"
        ]
      }
    ]
  },
  {
    "id": "slack-stable-ids",
    "skill": "slack-mrkdwn",
    "category": "mentions",
    "group": "slack-mrkdwn/slack-stable-ids",
    "split": "development",
    "prompt": "Repair the message using the resolved IDs. Preserve the wording, labelled link and channel reference, disable both unfurl kinds. Do not notify any broader group. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-stable-ids/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-stable-ids/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-stable-ids/bad-1.txt",
        "fails": [
          "explicit-controls"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-stable-ids/bad-2.txt",
        "fails": [
          "media-unfurls"
        ]
      }
    ],
    "assertions": [
      {
        "id": "explicit-controls",
        "op": "equals",
        "path": [
          "text"
        ],
        "value": "<@U123ABC> please review <https://example.com/42|release 42> in <#C123ABC>."
      },
      {
        "id": "link-unfurls",
        "op": "equals",
        "path": [
          "unfurl_links"
        ],
        "value": false
      },
      {
        "id": "media-unfurls",
        "op": "equals",
        "path": [
          "unfurl_media"
        ],
        "value": false
      }
    ]
  },
  {
    "id": "slack-missing-identity",
    "skill": "slack-mrkdwn",
    "category": "missing-information",
    "group": "slack-mrkdwn/slack-missing-identity",
    "split": "holdout",
    "prompt": "Prepare a ready-to-send personal mention for Ada. There is no directory/lookup tool and only her display name is known. Return status (ready/needs_identity), missing (identity fields), and text containing a plain visible fallback; do not invent an ID. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-mrkdwn/slack-missing-identity/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/slack-mrkdwn/slack-missing-identity/good-1.txt",
      "reference_outputs/slack-mrkdwn/slack-missing-identity/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-missing-identity/bad-1.txt",
        "fails": [
          "request-identity"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-missing-identity/bad-2.txt",
        "fails": [
          "fallback"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-missing-identity/bad-3.txt",
        "fails": [
          "missing-user-id"
        ]
      }
    ],
    "assertions": [
      {
        "id": "request-identity",
        "op": "equals",
        "path": [
          "status"
        ],
        "value": "needs_identity"
      },
      {
        "id": "missing-user-id",
        "op": "one_of",
        "path": [
          "missing"
        ],
        "value": [
          [
            "slack_user_id"
          ],
          [
            "user_id"
          ]
        ]
      },
      {
        "id": "fallback",
        "op": "equals",
        "path": [
          "text"
        ],
        "value": "Ada, please review release 42."
      }
    ]
  },
  {
