    "references": [
      "reference_outputs/slack-mrkdwn/slack-standard-markdown-field/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-mrkdwn/slack-standard-markdown-field/bad-1.txt",
        "fails": [
          "standard-markdown"
        ]
      },
      {
        "path": "reference_outputs/slack-mrkdwn/slack-standard-markdown-field/bad-2.txt",
        "fails": [
