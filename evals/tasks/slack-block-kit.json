  {
    "id": "slack-modal-input",
    "skill": "slack-block-kit",
    "category": "interactivity",
    "group": "slack-block-kit/slack-modal-input",
    "split": "development",
    "prompt": "Build the supplied modal request for views.open. Preserve trigger_id, callback_id, block_id, and action_id so the handler can read the submitted summary. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-modal-input/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-modal-input/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-modal-input/bad-1.txt",
        "fails": [
          "action"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-modal-input/bad-2.txt",
        "fails": [
          "trigger"
        ]
      }
    ],
    "assertions": [
      {
        "id": "trigger",
        "op": "equals",
        "path": [
          "trigger_id"
        ],
        "value": "trigger-from-interaction"
      },
      {
        "id": "callback",
        "op": "equals",
        "path": [
          "view",
          "callback_id"
        ],
        "value": "release_form"
      },
      {
        "id": "block",
        "op": "equals",
        "path": [
          "view",
          "blocks",
          0,
          "block_id"
        ],
        "value": "note"
      },
      {
        "id": "action",
        "op": "equals",
        "path": [
          "view",
          "blocks",
          0,
          "element",
          "action_id"
        ],
        "value": "summary"
      },
      {
        "id": "input-type",
        "op": "equals",
        "path": [
          "view",
          "blocks",
          0,
          "element",
          "type"
        ],
        "value": "plain_text_input"
      }
    ],
    "runtime": {
      "surface": "modal",
      "payload_path": [
        "view"
      ]
    }
  },
  {
    "id": "slack-table-rows",
    "skill": "slack-block-kit",
    "category": "tabular-data",
    "group": "slack-block-kit/slack-table-rows",
    "split": "development",
    "prompt": "Create a static Slack table with the two supplied rows. Use raw_text cells and preserve row/column order. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-table-rows/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-table-rows/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-table-rows/bad-1.txt",
        "fails": [
          "slack-table-shape"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-table-rows/bad-2.txt",
        "fails": [
          "data"
        ]
      }
    ],
    "assertions": [
      {
        "id": "headers",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          0
        ],
        "value": [
          {
            "type": "raw_text",
            "text": "Service"
          },
          {
            "type": "raw_text",
            "text": "Status"
          }
        ]
      },
      {
        "id": "data",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          1
        ],
        "value": [
          {
            "type": "raw_text",
            "text": "API"
          },
          {
            "type": "raw_text",
            "text": "Healthy"
          }
        ]
      }
    ],
    "runtime": {
      "surface": "message",
      "allow_raw_block": true
    }
  },
  {
    "id": "slack-sortable-table",
    "skill": "slack-block-kit",
    "category": "data-types",
    "group": "slack-block-kit/slack-sortable-table",
    "split": "development",
    "prompt": "Build a sortable data_table captioned Service latency. Keep header and row order. Latencies must be numeric cells so sorting is numeric. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-sortable-table/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-sortable-table/good-1.txt",
      "reference_outputs/slack-block-kit/slack-sortable-table/good-2.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-sortable-table/bad-1.txt",
        "fails": [
          "slack-table-shape"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-sortable-table/bad-2.txt",
        "fails": [
          "numeric-cell",
          "numeric-value"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-sortable-table/bad-3.txt",
        "fails": [
          "all-rows",
          "second-service",
          "second-number"
        ]
      }
    ],
    "assertions": [
      {
        "id": "caption",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "caption"
        ],
        "value": "Service latency"
      },
      {
        "id": "numeric-cell",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          1,
          1,
          "type"
        ],
        "value": "raw_number"
      },
      {
        "id": "numeric-value",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          1,
          1,
          "value"
        ],
        "value": 12
      },
      {
        "id": "all-rows",
        "op": "length",
        "path": [
          "blocks",
          0,
          "rows"
        ],
        "min": 3,
        "max": 3
      },
      {
        "id": "first-service",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          1,
          0,
          "text"
        ],
        "value": "API"
      },
      {
        "id": "second-service",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          2,
          0,
          "text"
        ],
        "value": "Worker"
      },
      {
        "id": "second-number",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          2,
          1,
          "value"
        ],
        "value": 8
      },
      {
        "id": "second-number-type",
        "op": "equals",
        "path": [
          "blocks",
          0,
          "rows",
          2,
          1,
          "type"
        ],
        "value": "raw_number"
      }
    ],
    "runtime": {
      "surface": "message",
      "allow_raw_block": true
    }
  },
  {
    "id": "slack-markdown-method",
    "skill": "slack-block-kit",
    "category": "method-compatibility",
    "group": "slack-block-kit/slack-markdown-method",
    "split": "holdout",
    "prompt": "Prepare chat.postMessage using its standard-Markdown markdown_text argument. Preserve the channel and content. Do not combine incompatible top-level text/blocks fields. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-markdown-method/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-markdown-method/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-markdown-method/bad-1.txt",
        "fails": [
          "slack-method-fields",
          "no-text"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-markdown-method/bad-2.txt",
        "fails": [
          "content"
        ]
      }
    ],
    "assertions": [
      {
        "id": "channel",
        "op": "equals",
        "path": [
          "channel"
        ],
        "value": "C_RELEASES"
      },
      {
        "id": "content",
        "op": "equals",
        "path": [
          "markdown_text"
        ],
        "value": "## Release\n\n**Ready** \u2014 [runbook](https://example.com/runbook)"
      },
      {
        "id": "no-text",
        "op": "absent",
        "path": [
          "text"
        ]
      },
      {
        "id": "no-blocks",
        "op": "absent",
        "path": [
          "blocks"
        ]
      }
    ],
    "runtime": {
      "surface": "message",
      "method": "chat.postMessage"
    }
  },
  {
    "id": "slack-streaming-chunks",
    "skill": "slack-block-kit",
    "category": "streaming",
    "group": "slack-block-kit/slack-streaming-chunks",
    "split": "development",
    "prompt": "Prepare a chunks-only chat.appendStream SDK call using the supplied IDs. Use a flat task_update chunk with id, title, and status; do not nest a task object or send top-level blocks. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-streaming-chunks/input.json"
    ],
    "grader": "contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-streaming-chunks/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-streaming-chunks/bad-1.txt",
        "fails": [
          "flat-task-id",
          "status"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-streaming-chunks/bad-2.txt",
        "fails": [
          "no-top-level-blocks"
        ]
      }
    ],
    "assertions": [
      {
        "id": "channel",
        "op": "equals",
        "path": [
          "channel"
        ],
        "value": "C_RELEASES"
      },
      {
        "id": "stream-id",
        "op": "equals",
        "path": [
          "ts"
        ],
        "value": "123.456"
      },
      {
        "id": "chunk-type",
        "op": "equals",
        "path": [
          "chunks",
          0,
          "type"
        ],
        "value": "task_update"
      },
      {
        "id": "flat-task-id",
        "op": "equals",
        "path": [
          "chunks",
          0,
          "id"
        ],
        "value": "build"
      },
      {
        "id": "status",
        "op": "equals",
        "path": [
          "chunks",
          0,
          "status"
        ],
        "value": "complete"
      },
      {
        "id": "no-top-level-blocks",
        "op": "absent",
        "path": [
          "blocks"
        ]
      }
    ]
  },
