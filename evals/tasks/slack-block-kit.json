[
  {
    "id": "slack-message-alert",
    "skill": "slack-block-kit",
    "category": "surface-compatibility",
    "group": "slack-block-kit/slack-message-alert",
    "split": "development",
    "prompt": "Repair this message-surface alert. Preserve the warning and its complete fallback text; use a message-compatible block. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-message-alert/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-message-alert/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-message-alert/bad-1.txt",
        "fails": [
          "slack-surface"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-message-alert/bad-2.txt",
        "fails": [
          "warning-preserved"
        ]
      }
    ],
    "assertions": [
      {
        "id": "warning-preserved",
        "op": "contains",
        "path": [
          "text"
        ],
        "value": "Dependency conflict detected"
      },
      {
        "id": "body-preserved",
        "op": "contains",
        "path": [
          "blocks",
          0,
          "text",
          "text"
        ],
        "value": "Dependency conflict detected"
      }
    ],
    "runtime": {
      "surface": "message"
    }
  },
  {
    "id": "slack-header-renderer",
    "skill": "slack-block-kit",
    "category": "text-object-types",
    "group": "slack-block-kit/slack-header-renderer",
    "split": "development",
    "prompt": "Use a header for Release status and formatted body text API is ready. Header text must use its supported text-object renderer. Return only JSON using the requested fields; preserve supplied identifiers.",
    "inputs": [
      "fixtures/slack-block-kit/slack-header-renderer/input.json"
    ],
    "grader": "slack-contract",
    "references": [
      "reference_outputs/slack-block-kit/slack-header-renderer/good-1.txt"
    ],
    "counterexamples": [
      {
        "path": "reference_outputs/slack-block-kit/slack-header-renderer/bad-1.txt",
        "fails": [
          "slack-text-objects"
        ]
      },
      {
        "path": "reference_outputs/slack-block-kit/slack-header-renderer/bad-2.txt",
        "fails": [
          "body"
        ]
      }
    ],
    "assertions": [
      {
        "id": "title",
        "op": "equals",
        "path": [
          "blocks",
          0,
