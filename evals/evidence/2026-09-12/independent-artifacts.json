      "id": "ddd-order-confirm",
      "skill": "clean-ddd-hexagonal",
      "split": "holdout",
      "artifact": "export class Order {\n  #id;\n  #items;\n  #status = 'DRAFT';\n  #events = [];\n\n  constructor(id, items) {\n    if (!Array.isArray(items)) {\n      throw new TypeError('items must be an array');\n    }\n\n    this.#id = id;\n    this.#items = Array.from(items, item => {\n      if (item === null || typeof item !== 'object') {\n        throw new TypeError('Each item must be an object');\n      }\n\n      const { quantity, priceCents } = item;\n      if (!Number.isSafeInteger(quantity) || quantity <= 0) {\n        throw new RangeError('quantity must be a positive safe integer');\n      }\n      if (!Number.isSafeInteger(priceCents) || priceCents < 0) {\n        throw new RangeError('priceCents must be a nonnegative safe integer');\n      }\n      return { quantity, priceCents };\n    });\n  }\n\n  get id() {\n    return this.#id;\n  }\n\n  get status() {\n    return this.#status;\n  }\n\n  get events() {\n    return this.#events.map(event => ({ ...event }));\n  }\n\n  get totalCents() {\n    return this.#items.reduce(\n      (total, item) => total + item.quantity * item.priceCents,\n      0,\n    );\n  }\n\n  confirm() {\n    if (this.#status === 'CONFIRMED') {\n      throw new Error('Order is already confirmed');\n    }\n    if (this.#items.length === 0) {\n      throw new Error('Cannot confirm an empty order');\n    }\n\n    this.#status = 'CONFIRMED';\n    this.#events.push({ type: 'OrderConfirmed', orderId: this.#id });\n  }\n}\n",
      "artifact_sha256": "2ae99bec320129d9b2792ababfd2b563887f31ad91eecc71853f8e365c4cb809",
